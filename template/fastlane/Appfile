# The Expo config is the source of truth for the identifiers — read it rather
# than repeating them here and letting the two drift (env overrides
# APP_IDENTIFIER / APPLE_TEAM_ID come from the action's inputs).
#
# Values are set only when resolved; the Fastfile validates them and raises
# the actionable error. Raising here would be useless — fastlane reads the
# Appfile through try_fetch_value, which swallows exceptions.
#
# fastlane evaluates this file with a bare eval (no filename), so __dir__ is
# nil here; fall back to finding expo_config.rb from the working directory
# (fastlane runs from the project root).
dir = [__dir__, File.join(Dir.pwd, "fastlane"), Dir.pwd].compact
      .find { |d| File.exist?(File.join(d, "expo_config.rb")) }
require File.join(dir, "expo_config.rb") if dir

identifier = ExpoConfig.bundle_identifier
team = ExpoConfig.team_id

app_identifier(identifier) if identifier
team_id(team) if team
