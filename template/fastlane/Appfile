# The Expo config is the source of truth for the identifiers — read it rather
# than repeating them here and letting the two drift. Projects using
# app.config.js/ts have no static app.json, so fall back to letting Expo
# resolve the config itself. Either value can be overridden via env
# (APP_IDENTIFIER / APPLE_TEAM_ID), which the action exposes as inputs.
require "json"

root = File.expand_path("..", __dir__)
app_json = File.join(root, "app.json")

expo =
  if File.exist?(app_json)
    json = JSON.parse(File.read(app_json))
    json["expo"] || json
  else
    JSON.parse(Dir.chdir(root) { `npx expo config --json` })
  end

identifier = ENV["APP_IDENTIFIER"] || expo.dig("ios", "bundleIdentifier")
team = ENV["APPLE_TEAM_ID"] || expo.dig("ios", "appleTeamId")

raise "No bundle identifier: set expo.ios.bundleIdentifier or the app-identifier input" if identifier.to_s.empty?
raise "No Apple team id: set expo.ios.appleTeamId or the team-id input" if team.to_s.empty?

app_identifier(identifier)
team_id(team)
