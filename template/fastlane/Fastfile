# Release lane for an Expo iOS app, installed by action-expo-fastlane.
#
# The native ios/ project is generated (expo prebuild) and gitignored, so the
# lane regenerates it first — nothing here may assume ios/ exists beforehand,
# or edit it expecting the change to survive the next prebuild.
#
# Signing is fastlane match with manual signing. The encrypted certificate
# repo comes from MATCH_GIT_URL; by default CI runs match readonly and only
# downloads what the repo already holds (needs MATCH_PASSWORD and SSH
# access). Set MATCH_READONLY=false — with a write deploy key — to let match
# create or repair certificates and profiles from CI.
#
# App Store Connect API key (used by match and the TestFlight upload):
#   ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY_P8_BASE64 (base64 of the
#   .p8, what CI sets) or the .p8 sitting at the usual local path,
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8.
#
# Build number, upload and dev client arrive as env (BUILD_NUMBER, UPLOAD,
# DEV_CLIENT — what the action sets); lane options (release build_number:42
# upload:true) override them for local runs.
require "pathname"

# fastlane parses this file with `eval` under a relative filename, so __dir__
# is "." here, not the lane directory (the Appfile has it worse: nil). Find
# expo_config.rb from the working directory — fastlane parses from the
# fastlane folder — and take every real path from ExpoConfig, where __dir__
# resolves properly because it is a required file.
lane_dir = [__dir__, File.join(Dir.pwd, "fastlane"), Dir.pwd].compact
           .find { |d| File.exist?(File.join(d, "expo_config.rb")) }
raise "expo_config.rb not found next to the Fastfile (looked from #{Dir.pwd})" unless lane_dir
require File.join(lane_dir, "expo_config.rb")

default_platform(:ios)

ROOT = ExpoConfig::ROOT
# Icon for dev-client builds, shipped next to this lane. Expo resolves icon
# paths against the project root, so hand it the relative one.
DEV_ICON = Pathname.new(ExpoConfig::LANE_DIR).relative_path_from(Pathname.new(ROOT)).join("dev-icon.png").to_s

platform :ios do
  desc "Archive + export a signed IPA (release build_number:42 upload:true distribution:ad-hoc dev_client:true)"
  lane :release do |options|
    # readonly by default in CI: only download what the cert repo already
    # holds. With a write deploy key, MATCH_READONLY=false lets match create
    # or repair the App Store profile right from CI (needs the ASC api key).
    #
    # Read *before* setup_ci: that action overwrites ENV["MATCH_READONLY"]
    # with "true" unconditionally (an `=`, not the `||=` setup_jenkins uses),
    # so reading it afterwards would silently ignore match-readonly: false.
    match_readonly = ENV["MATCH_READONLY"].nil? ? is_ci : ENV["MATCH_READONLY"] == "true"

    setup_ci if is_ci # fresh unlocked keychain for match to install into

    # app-store (default) or ad-hoc. Both sign with the Apple Distribution
    # certificate; only the profile type and export method differ. match
    # spells the profile type without the hyphen.
    distribution = (options[:distribution] || ExpoConfig.env("DISTRIBUTION") || "app-store").to_s
    match_type = { "app-store" => "appstore", "ad-hoc" => "adhoc" }[distribution]
    UI.user_error!("distribution must be app-store or ad-hoc, got '#{distribution}'") unless match_type

    # The Appfile sets the identifiers only when it can resolve them (its own
    # raise would be swallowed by try_fetch_value), so validate here, up
    # front, before any build work.
    identifier = ExpoConfig.bundle_identifier
    UI.user_error!("No bundle identifier: set expo.ios.bundleIdentifier or the app-identifier input") unless identifier
    UI.user_error!("No Apple team id: set expo.ios.appleTeamId or the team-id input") unless ExpoConfig.team_id

    # Lane option first (local runs: no option means no upload), then the
    # UPLOAD env from the action, where "auto" means "upload when the
    # distribution supports it" — so plain ad-hoc runs need no upload:false.
    upload =
      if options.key?(:upload)
        options[:upload].to_s == "true"
      else
        case ENV["UPLOAD"].to_s
        when "auto" then distribution == "app-store"
        when "true" then true
        else false
        end
      end
    build_number = (options[:build_number] || ExpoConfig.env("BUILD_NUMBER"))&.to_s

    # A dev-client build is just the Debug configuration archived with the
    # same distribution signing: React Native's bundling phase is a no-op in
    # Debug, so the IPA ships no JS and expo-dev-client loads it from a Metro
    # server instead. Works with either distribution — the export method and
    # profile are unchanged.
    dev_client =
      if options.key?(:dev_client)
        options[:dev_client].to_s == "true"
      else
        ENV["DEV_CLIENT"].to_s == "true"
      end
    if dev_client && !ExpoConfig.dependency?("expo-dev-client")
      UI.user_error!(
        "dev_client needs expo-dev-client: without it the Debug build has no " \
        "dev launcher and no embedded JS bundle, so the app cannot start. " \
        "Run: npx expo install expo-dev-client"
      )
    end

    api_key = nil
    if ExpoConfig.env("ASC_KEY_ID") && ExpoConfig.env("ASC_ISSUER_ID")
      key_file = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV["ASC_KEY_ID"]}.p8")
      if ExpoConfig.env("ASC_KEY_P8_BASE64")
        api_key = app_store_connect_api_key(
          key_id: ENV["ASC_KEY_ID"],
          issuer_id: ENV["ASC_ISSUER_ID"],
          key_content: ENV["ASC_KEY_P8_BASE64"],
          is_key_content_base64: true
        )
      elsif File.exist?(key_file)
        api_key = app_store_connect_api_key(
          key_id: ENV["ASC_KEY_ID"],
          issuer_id: ENV["ASC_ISSUER_ID"],
          key_filepath: key_file
        )
      end
    end
    # Fail before the 20-minute archive, not after it.
    UI.user_error!("upload:true (TestFlight) requires app-store distribution") if upload && distribution != "app-store"
    UI.user_error!("upload:true needs the ASC_* API key variables set") if upload && api_key.nil?

    if build_number && !ExpoConfig.stamp_build_number(build_number)
      UI.important(
        "No app.json to stamp — make app.config.js set " \
        "ios.buildNumber from process.env.BUILD_NUMBER"
      )
    end

    # Mark the dev client with its own icon: it shares the real app's bundle
    # identifier, so it installs over it — the icon is what tells a tester
    # which of the two is on the device.
    if dev_client
      if !File.exist?(File.join(ROOT, DEV_ICON))
        UI.important("No #{DEV_ICON} — keeping the app's own icon")
      elsif !ExpoConfig.set_icon(DEV_ICON)
        UI.important(
          "No app.json to edit — make app.config.js set icon and ios.icon " \
          "from process.env.DEV_CLIENT"
        )
      end
    end

    Dir.chdir(ROOT) { sh(ENV.fetch("EXPO_PREBUILD_COMMAND", "npx expo prebuild --platform ios")) }

    xcodeproj = Dir[File.join(ROOT, "ios/*.xcodeproj")].first
    workspace = Dir[File.join(ROOT, "ios/*.xcworkspace")].first
    unless xcodeproj && workspace
      UI.user_error!(
        "prebuild produced no ios/*.xcworkspace — " \
        "does the prebuild command run pod install?"
      )
    end

    match(
      type: match_type,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      api_key: api_key,
      readonly: match_readonly
    )

    # Prebuild generates the project with automatic signing, which would mint
    # a throwaway development certificate on every CI run; flip it to the
    # match certificate + profile so the archive needs no Apple session.
    profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    update_code_signing_settings(
      path: xcodeproj,
      use_automatic_signing: false,
      code_sign_identity: "Apple Distribution",
      profile_name: profiles[identifier]
    )

    # Expo names workspace and scheme after expo.name, so derive them
    # (e.g. "Pet Trace" -> PetTrace.xcworkspace, scheme PetTrace).
    build_app(
      workspace: workspace,
      scheme: File.basename(workspace, ".xcworkspace"),
      configuration: dev_client ? "Debug" : "Release",
      export_method: distribution,
      export_options: { provisioningProfiles: profiles },
      output_directory: File.join(ROOT, "ios/build/ipa")
    )

    if upload
      upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    else
      UI.message("Skipping TestFlight upload (pass upload:true to enable).")
    end
  end
end
