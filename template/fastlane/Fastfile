# Release lane for an Expo iOS app, installed by action-expo-fastlane.
#
# The native ios/ project is generated (expo prebuild) and gitignored, so the
# lane regenerates it first — nothing here may assume ios/ exists beforehand,
# or edit it expecting the change to survive the next prebuild.
#
# Signing is fastlane match with manual signing. The encrypted certificate
# repo comes from MATCH_GIT_URL; in CI match runs readonly and only downloads
# what the repo already holds (needs MATCH_PASSWORD and SSH access).
#
# App Store Connect API key (used by match and the TestFlight upload):
#   ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY_P8_BASE64 (base64 of the
#   .p8, what CI sets) or the .p8 sitting at the usual local path,
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8.

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)

platform :ios do
  desc "Archive + export a signed IPA (release build_number:42 upload:true)"
  lane :release do |options|
    setup_ci if is_ci # fresh unlocked keychain for match to install into

    api_key = nil
    if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]
      key_file = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV["ASC_KEY_ID"]}.p8")
      if ENV["ASC_KEY_P8_BASE64"]
        api_key = app_store_connect_api_key(
          key_id: ENV["ASC_KEY_ID"],
          issuer_id: ENV["ASC_ISSUER_ID"],
          key_content: ENV["ASC_KEY_P8_BASE64"],
          is_key_content_base64: true
        )
      elsif File.exist?(key_file)
        api_key = app_store_connect_api_key(
          key_id: ENV["ASC_KEY_ID"],
          issuer_id: ENV["ASC_ISSUER_ID"],
          key_filepath: key_file
        )
      end
    end

    # The build number ships from the Expo config — prebuild bakes it into the
    # project — so set it before prebuild rather than with agvtool after.
    # app.config.js/ts projects have no file to edit; they must map
    # ios.buildNumber from the BUILD_NUMBER env var themselves.
    if options[:build_number]
      app_json = File.join(ROOT, "app.json")
      if File.exist?(app_json)
        json = JSON.parse(File.read(app_json))
        cfg = json["expo"] || json
        (cfg["ios"] ||= {})["buildNumber"] = options[:build_number].to_s
        File.write(app_json, JSON.pretty_generate(json) + "\n")
      else
        UI.important(
          "No app.json to stamp — make app.config.js set " \
          "ios.buildNumber from process.env.BUILD_NUMBER"
        )
      end
    end

    Dir.chdir(ROOT) { sh(ENV.fetch("EXPO_PREBUILD_COMMAND", "npx expo prebuild --platform ios")) }

    match(
      type: "appstore",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      api_key: api_key,
      readonly: is_ci
    )

    # Prebuild generates the project with automatic signing, which would mint
    # a throwaway development certificate on every CI run; flip it to the
    # match certificate + profile so the archive needs no Apple session.
    identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    update_code_signing_settings(
      path: Dir[File.join(ROOT, "ios/*.xcodeproj")].first,
      use_automatic_signing: false,
      code_sign_identity: "Apple Distribution",
      profile_name: profiles[identifier]
    )

    # Expo names workspace and scheme after expo.name, so derive them
    # (e.g. "Pet Trace" -> PetTrace.xcworkspace, scheme PetTrace).
    workspace = Dir[File.join(ROOT, "ios/*.xcworkspace")].first
    build_app(
      workspace: workspace,
      scheme: File.basename(workspace, ".xcworkspace"),
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles },
      output_directory: File.join(ROOT, "ios/build/ipa")
    )

    if options[:upload]
      UI.user_error!("upload:true needs the ASC_* API key variables set") unless api_key
      upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    else
      UI.message("Skipping TestFlight upload (pass upload:true to enable).")
    end
  end
end
